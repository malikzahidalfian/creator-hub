# Copy to .env.local for npm run dev. Never use a VITE_ prefix for these secrets.
# Bootstrap password only (12-128 characters), used when no stored credential exists.
# After initialization, change the password from Akun & Keamanan in the app.
APP_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Project URL and server-only service_role / secret key from Supabase settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: file for local development (default), supabase for Vercel/production.
# Run migrations/001_workspace_credentials.sql before using the Supabase store.
# AUTH_STORE=supabase
# AUTH_FILE=.private/workspace-auth.json

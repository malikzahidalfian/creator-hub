# Copy to .env.local for npm run dev. Never use a VITE_ prefix for these secrets.
# Choose a NEW strong password (at least 12 characters).
APP_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Project URL and server-only service_role / secret key from Supabase settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
